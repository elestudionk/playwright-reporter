{
  "name": "@estudio-nk/playwright-reporter",
  "version": "0.3.0",
  "description": "Playwright reporter that records automated runs in nk.proof",
  "license": "MIT",
  "author": "El Estudio NK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elestudionk/playwright-reporter.git"
  },
  "bugs": {
    "url": "https://github.com/elestudionk/playwright-reporter/issues"
  },
  "homepage": "https://github.com/elestudionk/playwright-reporter#readme",
  "keywords": [
    "playwright",
    "reporter",
    "nk.proof",
    "testing",
    "e2e"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "test": [
        "dist/test.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
