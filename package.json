{
  "name": "@nkstudio/playwright-reporter",
  "version": "0.1.0",
  "description": "Playwright reporter that records automated runs in nk.proof",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "test": ["dist/test.d.ts"]
    }
  },
  "files": ["dist", "template"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.42"
  },
  "engines": {
    "node": ">=18"
  }
}
